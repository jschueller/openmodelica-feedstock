diff --git a/OMCompiler/SimulationRuntime/OMSICpp/CMakeLists.txt b/OMCompiler/SimulationRuntime/OMSICpp/CMakeLists.txt
index 650bf46e31..a259a2cfab 100644
--- a/OMCompiler/SimulationRuntime/OMSICpp/CMakeLists.txt
+++ b/OMCompiler/SimulationRuntime/OMSICpp/CMakeLists.txt
@@ -492,19 +492,27 @@ elseif(NOT FMU_TARGET)
   message(STATUS "Boost thread disabled because of available C++11 support")
 endif(NOT(COMPILER_SUPPORTS_CXX11))
 
-IF(NOT FMU_TARGET)
-if(CMAKE_VERSION VERSION_LESS "3.30.0")
-  FIND_PACKAGE(Boost REQUIRED COMPONENTS filesystem serialization program_options)
+if(FMU_TARGET)
+  set(BOOST_REQUIRED "")
 else()
-  FIND_PACKAGE(Boost CONFIG COMPONENTS filesystem serialization program_options REQUIRED)
+  set(BOOST_REQUIRED REQUIRED)
 endif()
-ELSE(NOT FMU_TARGET)
 if(CMAKE_VERSION VERSION_LESS "3.30.0")
-  FIND_PACKAGE(Boost COMPONENTS filesystem serialization program_options)
+  FIND_PACKAGE(Boost ${BOOST_REQUIRED} COMPONENTS filesystem serialization program_options)
 else()
-  FIND_PACKAGE(Boost CONFIG COMPONENTS filesystem serialization program_options)
+  FIND_PACKAGE(Boost CONFIG ${BOOST_REQUIRED} COMPONENTS filesystem serialization program_options)
+  # In CONFIG mode, BoostConfig.cmake does not set Boost_INCLUDE_DIR.
+  # Extract it from any available Boost target.
+  foreach(_bt Boost::boost Boost::headers Boost::program_options Boost::filesystem)
+    if(TARGET ${_bt})
+      get_target_property(_inc ${_bt} INTERFACE_INCLUDE_DIRECTORIES)
+      if(_inc AND NOT "${_inc}" MATCHES "-NOTFOUND$")
+        set(Boost_INCLUDE_DIR "${_inc}")
+        break()
+      endif()
+    endif()
+  endforeach()
 endif()
-ENDIF(NOT FMU_TARGET)
 
 # Use old C++ ABI for cross compilation of FMUs
 # because libstdc++ might not be upgraded yet
